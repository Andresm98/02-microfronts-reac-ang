# Copiar a .env para sobreescribir las URLs que los fronts embeben en build (VITE_* se resuelven en build).
VITE_MF_CLIENTES_URL=http://localhost:5001/remoteEntry.js
VITE_MF_VENTAS_URL=http://localhost:5002/remoteEntry.js
# Nota: VITE_API_URL lo usan mf-clientes (3001) y mf-ventas (3002) con valores distintos;
# no lo definas aquí de forma global o ambos fronts tomarán el mismo valor.
VITE_CLIENTES_API_URL=http://localhost:3001
